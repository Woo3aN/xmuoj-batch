{
  "name": "xmuoj-batch",
  "displayName": "XMUOJ Batch",
  "description": "XMUOJ 配套插件：批量提交评测 + Git 同步",
  "version": "1.0.0",
  "publisher": "woo3an",
  "engines": { "vscode": "^1.88.0" },
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Woo3aN/xmuoj-batch"
  },
  "activationEvents": [
    "onCommand:xmuoj-batch.submitAll",
    "onCommand:xmuoj-batch.gitPull",
    "onCommand:xmuoj-batch.gitPush",
    "onCommand:xmuoj-batch.gitSetup",
    "onCommand:xmuoj-batch.runLocalTests"
  ],
  "contributes": {
    "commands": [
      {
        "command": "xmuoj-batch.submitAll",
        "title": "XMUOJ: 批量提交评测",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "xmuoj-batch.gitPull",
        "title": "XMUOJ: 同步拉取 (git pull)",
        "icon": "$(repo-pull)"
      },
      {
        "command": "xmuoj-batch.gitPush",
        "title": "XMUOJ: 提交并推送 (git push)",
        "icon": "$(repo-push)"
      },
      {
        "command": "xmuoj-batch.gitSetup",
        "title": "XMUOJ: 初始化 Git 仓库",
        "icon": "$(repo-create)"
      },
      {
        "command": "xmuoj-batch.downloadSamples",
        "title": "XMUOJ: 批量下载样本数据",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xmuoj-batch.runLocalTests",
        "title": "XMUOJ: 批量本地测试",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "xmuoj-batch.submitAll", "when": "true" },
        { "command": "xmuoj-batch.gitPull", "when": "true" },
        { "command": "xmuoj-batch.gitPush", "when": "true" },
        { "command": "xmuoj-batch.gitSetup", "when": "true" },
        { "command": "xmuoj-batch.runLocalTests", "when": "true" }
      ],
      "editor/title": [
        { "command": "xmuoj-batch.submitAll", "group": "navigation", "when": "resourcePath =~ /contest-/" }
      ]
    }
  }
}
